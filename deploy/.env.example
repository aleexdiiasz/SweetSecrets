# Copiar como deploy/.env y reemplazar todos los placeholders.
# Nunca confirmar deploy/.env ni valores reales en Git.
WEB_HTTP_PORT=8080
POSTGRES_USER=replace_with_database_owner
POSTGRES_PASSWORD=replace_with_strong_database_password
MASTER_CONNECTION_STRING=Host=postgres;Port=5432;Database=sweetsecrets_master;Username=replace_with_database_owner;Password=replace_with_strong_database_password
PUBLIC_BASE_URL=https://sweetsecrets.example
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=replace_if_required
SMTP_PASSWORD=replace_if_required
SMTP_FROM_EMAIL=no-reply@example.invalid
SMTP_FROM_NAME=SweetSecrets
BOOTSTRAP_ADMIN_EMAIL=owner@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_initial_password
BOOTSTRAP_ADMIN_FULL_NAME=Platform Administrator
