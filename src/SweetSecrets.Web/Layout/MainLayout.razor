@inherits LayoutComponentBase

@using SweetSecrets.Web.Services.Auth

@inject AuthApiClient AuthApiClient
@inject NavigationManager Navigation

<div class="app-shell">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <div class="app-main">
        <header class="app-header">
            <div class="app-header-content">
                <span class="app-header-context">
                    Panel de control
                </span>

                <strong class="app-header-title">
                    SweetSecrets
                </strong>
            </div>

            <div class="app-header-actions">
                <AuthorizeView Roles="TENANT_OWNER">
                    <Authorized>
                        <a class="account-link" href="/cuenta">Mi cuenta</a>
                    </Authorized>
                </AuthorizeView>
                <button type="button"
                        class="logout-button"
                        @onclick="LogoutAsync">
                    Cerrar sesión
                </button>
            </div>
        </header>

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

@code {
    private async Task LogoutAsync()
    {
        await AuthApiClient.LogoutAsync();

        Navigation.NavigateTo(
            "/login",
            replace: true);
    }
}
