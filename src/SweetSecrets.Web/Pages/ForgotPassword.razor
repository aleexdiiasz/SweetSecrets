@page "/forgot-password"
@layout AuthLayout

@using SweetSecrets.Contracts.Auth
@using SweetSecrets.Web.Services.Auth

@inject AuthApiClient AuthApiClient

<PageTitle>Recuperar contraseña - SweetSecrets</PageTitle>

<div class="recovery-card">
    <div class="recovery-header">
        <h1>Recuperar contraseña</h1>
        <p>Escribe tu correo y te enviaremos las instrucciones disponibles para restablecerla.</p>
    </div>

    @if (_successMessage is not null)
    {
        <div class="recovery-success" role="status">@_successMessage</div>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <div class="form-group">
                <label for="recovery-email">Correo electrónico</label>
                <InputText id="recovery-email" class="form-control" type="email" autocomplete="email" @bind-Value="_model.Email" />
            </div>

            @if (_errorMessage is not null)
            {
                <div class="recovery-error" role="alert">@_errorMessage</div>
            }

            <button type="submit" class="recovery-button" disabled="@_isSubmitting">
                @(_isSubmitting ? "Enviando..." : "Enviar instrucciones")
            </button>
        </EditForm>
    }

    <p class="auth-link"><a href="/login">Volver a iniciar sesión</a></p>
</div>

@code {
    private readonly ForgotPasswordRequest _model = new();
    private bool _isSubmitting;
    private string? _errorMessage;
    private string? _successMessage;

    private async Task SubmitAsync()
    {
        if (_isSubmitting)
            return;

        _errorMessage = string.IsNullOrWhiteSpace(_model.Email) ||
            !_model.Email.Contains('@', StringComparison.Ordinal)
                ? "Ingresa un correo electrónico válido."
                : null;

        if (_errorMessage is not null)
            return;

        _isSubmitting = true;

        try
        {
            var result = await AuthApiClient.ForgotPasswordAsync(_model);

            if (!result.Succeeded)
            {
                _errorMessage = result.ErrorMessage ?? "No fue posible procesar la solicitud.";
                return;
            }

            _successMessage = result.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
