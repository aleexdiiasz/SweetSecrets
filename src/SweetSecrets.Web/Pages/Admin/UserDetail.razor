@page "/admin/users/{Id:guid}"
@layout AdminLayout
@attribute [Authorize(Roles = "PLATFORM_ADMIN")]
@using SweetSecrets.Contracts.Admin.Users
@using SweetSecrets.Web.Services.Admin
@inject UsersAdminApiClient Api
<PageTitle>Detalle de usuario - SweetSecrets</PageTitle>
<section class="user-detail"><a href="/admin/users">← Volver a usuarios</a>
@if(loading){<div class="state">Cargando usuario...</div>}else if(error is not null){<div class="state error" role="alert">@error <button @onclick="LoadAsync">Reintentar</button></div>}else if(user is not null){<header><div><span>@user.Role</span><h1>@user.FullName</h1><p>@user.Email</p></div><em class="badge @(user.IsOnline?"online":"offline")">@(user.IsOnline?"Online":"Offline")</em></header>@if(success is not null){<div class="success">@success</div>}<div class="grid"><article><h2>Cuenta</h2><dl><dt>Estado</dt><dd>@(user.IsBlocked?"Bloqueada":user.IsActive?"Habilitada":"Inactiva")</dd><dt>Correo</dt><dd>@(user.EmailConfirmed?"Confirmado":"Pendiente")</dd><dt>Creación</dt><dd>@Format(user.CreatedAt)</dd><dt>Último login</dt><dd>@Format(user.LastLoginAt)</dd><dt>Última actividad</dt><dd>@Format(user.LastActivityAt)</dd></dl></article><article><h2>Tenant</h2><dl><dt>Código</dt><dd>@(user.TenantCode??"—")</dd><dt>Nombre</dt><dd>@(user.TenantName??"Sin tenant")</dd></dl></article></div>
<article class="actions"><h2>Acciones</h2>@if(user.Role=="PLATFORM_ADMIN"){<p>Las cuentas PLATFORM_ADMIN son de solo lectura.</p>}else if(!confirming){<button @onclick="()=>confirming=true" disabled="@saving">@(user.IsBlocked?"Desbloquear usuario":"Bloquear usuario")</button>}else{<div class="confirm"><strong>¿Confirmas esta acción?</strong><button @onclick="ChangeAsync" disabled="@saving">@(saving?"Guardando...":"Confirmar")</button><button class="secondary" @onclick="()=>confirming=false" disabled="@saving">Cancelar</button></div>}</article>
<article><h2>Sesiones recientes</h2>@if(user.RecentSessions.Count==0){<p>Sin sesiones registradas.</p>}else{<div class="compact">@foreach(var s in user.RecentSessions){<div><strong>@(s.IsActive?"Activa":"Cerrada")</strong><span>@Format(s.LastActivityAt)</span><small>@(s.UserAgent??"Agente no disponible")</small></div>}</div>}</article><article><h2>Auditoría reciente</h2>@if(user.RecentAudit.Count==0){<p>Sin movimientos relacionados.</p>}else{<div class="compact">@foreach(var a in user.RecentAudit){<div><strong>@a.Action</strong><span>@a.Description</span><small>@Format(a.CreatedAt)</small></div>}</div>}</article>}
</section>
@code{[Parameter]public Guid Id{get;set;}private PlatformUserDetailResponse? user;private bool loading=true,saving,confirming;private string? error,success;protected override Task OnParametersSetAsync()=>LoadAsync();private async Task LoadAsync(){loading=true;error=null;try{user=await Api.GetUserAsync(Id);if(user is null)error="El usuario no existe.";}catch(HttpRequestException){error="No fue posible cargar el usuario.";}finally{loading=false;}}private async Task ChangeAsync(){if(user is null||saving)return;saving=true;error=null;try{var block=!user.IsBlocked;await Api.SetBlockedAsync(Id,block);success=block?"Usuario bloqueado y sesiones cerradas.":"Usuario desbloqueado correctamente.";confirming=false;await LoadAsync();}catch(HttpRequestException ex){error=ex.Message;}finally{saving=false;}}private static string Format(DateTime? d)=>d?.ToLocalTime().ToString("dd MMM yyyy HH:mm")??"—";}
