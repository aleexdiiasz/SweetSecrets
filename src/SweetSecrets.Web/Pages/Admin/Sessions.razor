@page "/admin/sessions"
@layout AdminLayout
@attribute [Authorize(Roles = "PLATFORM_ADMIN")]
@using SweetSecrets.Contracts.Admin.Users
@using SweetSecrets.Web.Services.Admin
@inject UsersAdminApiClient Api
<PageTitle>Sesiones - SweetSecrets</PageTitle>
<section class="sessions"><header><span>Plataforma</span><h1>Sesiones</h1><p>Actividad de autenticación registrada en MASTER.</p></header><div class="filters"><input placeholder="Usuario, correo o tenant" aria-label="Buscar sesiones" @bind="search" @bind:event="oninput"/><select @bind="status"><option value="">Todas</option><option value="active">Activas</option><option value="closed">Cerradas</option></select><button @onclick="LoadAsync" disabled="@loading">Buscar</button></div>
@if(loading){<div class="state">Cargando sesiones...</div>}else if(error is not null){<div class="state error" role="alert">@error <button @onclick="LoadAsync">Reintentar</button></div>}else if(result?.Items.Count==0){<div class="state">No hay sesiones que coincidan.</div>}else if(result is not null){<p>@result.TotalCount resultado(s)</p><div class="session-list">@foreach(var item in result.Items){<article><div><strong>@item.UserName</strong><small>@item.Email · @(item.TenantCode??"Plataforma")</small></div><div><em class="badge @(item.IsActive?"active":"closed")">@(item.IsActive?"Activa":"Cerrada")</em><small>Actividad: @Format(item.LastActivityAt)</small></div><div><strong>@(item.IpAddress??"IP no disponible")</strong><small title="@item.UserAgent">@ShortAgent(item.UserAgent)</small></div><div>@if(item.IsActive&&item.Role!="PLATFORM_ADMIN"){if(confirming==item.Id){<button @onclick="()=>RevokeAsync(item.Id)" disabled="@saving">@(saving?"Revocando...":"Confirmar")</button><button class="secondary" @onclick="()=>confirming=null" disabled="@saving">Cancelar</button>}else{<button @onclick="()=>confirming=item.Id">Revocar</button>}}</div></article>}</div>}
</section>
@code{private PlatformSessionPageResponse? result;private string? search,status,error;private bool loading=true,saving;private Guid? confirming;protected override Task OnInitializedAsync()=>LoadAsync();private async Task LoadAsync(){loading=true;error=null;try{bool? active=status=="active"?true:status=="closed"?false:null;result=await Api.SearchSessionsAsync(search,active);}catch(HttpRequestException){error="No fue posible cargar las sesiones.";}finally{loading=false;}}private async Task RevokeAsync(Guid id){if(saving)return;saving=true;error=null;try{await Api.RevokeSessionAsync(id);confirming=null;await LoadAsync();}catch(HttpRequestException ex){error=ex.Message;}finally{saving=false;}}private static string Format(DateTime d)=>d.ToLocalTime().ToString("dd MMM yyyy HH:mm");private static string ShortAgent(string? value)=>string.IsNullOrWhiteSpace(value)?"Agente no disponible":value.Length>70?value[..70]+"…":value;}
