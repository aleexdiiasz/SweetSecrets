@page "/admin/tenants/{Id:guid}"
@layout AdminLayout
@attribute [Authorize(Roles = "PLATFORM_ADMIN")]
@using SweetSecrets.Contracts.Admin.Tenants
@using SweetSecrets.Web.Services.Admin
@inject TenantsAdminApiClient Api

<PageTitle>Detalle de tenant - SweetSecrets</PageTitle>
<section class="detail-page">
    <a href="/admin/tenants">← Volver a tenants</a>
    @if(loading){<div class="state">Cargando tenant...</div>}
    else if(error is not null){<div class="state error" role="alert">@error <button @onclick="LoadAsync">Reintentar</button></div>}
    else if(tenant is not null){
        <header><div><span>@tenant.Code</span><h1>@tenant.Name</h1></div><em class="status">@tenant.Status</em></header>
        @if(success is not null){<div class="success" role="status">@success</div>}
        <div class="detail-grid"><article><h2>Información general</h2><dl><dt>Estado</dt><dd>@tenant.Status</dd><dt>Creación</dt><dd>@Format(tenant.CreatedAt)</dd><dt>Última modificación</dt><dd>@Format(tenant.UpdatedAt)</dd></dl></article><article><h2>Owner principal</h2><dl><dt>Nombre</dt><dd>@(tenant.OwnerName??"Sin owner")</dd><dt>Correo</dt><dd>@(tenant.OwnerEmail??"—")</dd><dt>Último login</dt><dd>@Format(tenant.OwnerLastLoginAt)</dd><dt>Última actividad</dt><dd>@Format(tenant.OwnerLastActivityAt)</dd></dl></article></div>
        @if(tenant.Status is "Active" or "Suspended"){
            <article class="actions"><h2>Estado operativo</h2><p>@(tenant.Status=="Active"?"Suspender impide el acceso operacional y conserva todos los datos.":"Reactivar restaura el acceso operacional del tenant.")</p>
            @if(!confirming){<button @onclick="()=>confirming=true" disabled="@saving">@(tenant.Status=="Active"?"Suspender tenant":"Reactivar tenant")</button>}
            else{<div class="confirm"><strong>¿Confirmas esta operación?</strong><button @onclick="ChangeStatusAsync" disabled="@saving">@(saving?"Guardando...":"Confirmar")</button><button class="secondary" @onclick="()=>confirming=false" disabled="@saving">Cancelar</button></div>}
            </article>}
        <article class="audit">
            <h2>Auditoría reciente</h2>
            @if (tenant.RecentAudit.Count == 0)
            {
                <p>Sin movimientos registrados.</p>
            }
            else
            {
                @foreach (var item in tenant.RecentAudit)
                {
                    <div><strong>@item.Action</strong><span>@item.Description</span><small>@Format(item.CreatedAt)</small></div>
                }
            }
        </article>
    }
</section>
@code{
    [Parameter] public Guid Id{get;set;} private TenantDetailResponse? tenant;private bool loading=true,saving,confirming;private string? error,success;
    protected override Task OnParametersSetAsync()=>LoadAsync();
    private async Task LoadAsync(){loading=true;error=null;try{tenant=await Api.GetAsync(Id);if(tenant is null)error="El tenant no existe.";}catch(HttpRequestException){error="No fue posible cargar el tenant.";}finally{loading=false;}}
    private async Task ChangeStatusAsync(){if(tenant is null||saving)return;saving=true;error=null;try{await Api.ChangeStatusAsync(Id,tenant.Status=="Suspended");success=tenant.Status=="Active"?"Tenant suspendido correctamente.":"Tenant reactivado correctamente.";confirming=false;await LoadAsync();}catch(HttpRequestException ex){error=ex.Message;}finally{saving=false;}}
    private static string Format(DateTime? value)=>value.HasValue?value.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm"):"—";
}
