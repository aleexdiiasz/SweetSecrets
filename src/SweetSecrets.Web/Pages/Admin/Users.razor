@page "/admin/users"
@layout AdminLayout
@attribute [Authorize(Roles = "PLATFORM_ADMIN")]
@using SweetSecrets.Contracts.Admin.Users
@using SweetSecrets.Web.Services.Admin
@inject UsersAdminApiClient Api
<PageTitle>Usuarios - SweetSecrets</PageTitle>
<section class="admin-list"><header><span>Plataforma</span><h1>Usuarios</h1><p>Consulta identidades, acceso y actividad registrada en MASTER.</p></header>
<div class="filters"><input aria-label="Buscar usuarios" placeholder="Nombre, correo, tenant o código" @bind="search" @bind:event="oninput"/><select @bind="role"><option value="">Todos los roles</option><option value="TENANT_OWNER">Tenant owner</option><option value="PLATFORM_ADMIN">Platform admin</option></select><select @bind="state"><option value="">Cualquier estado</option><option value="blocked">Bloqueados</option><option value="available">No bloqueados</option><option value="online">Online</option><option value="offline">Offline</option></select><button @onclick="LoadAsync" disabled="@loading">Buscar</button></div>
@if(loading){<div class="state">Cargando usuarios...</div>}else if(error is not null){<div class="state error" role="alert">@error <button @onclick="LoadAsync">Reintentar</button></div>}else if(result?.Items.Count==0){<div class="state">No hay usuarios que coincidan.</div>}else if(result is not null){<p class="count">@result.TotalCount resultado(s)</p><div class="rows"><div class="row heading"><span>Usuario</span><span>Rol / tenant</span><span>Cuenta</span><span>Actividad</span><span></span></div>@foreach(var user in result.Items){<div class="row"><span><strong>@user.FullName</strong><small>@user.Email</small></span><span><strong>@RoleText(user.Role)</strong><small>@Tenant(user)</small></span><span><em class="badge @(user.IsBlocked?"blocked":"active")">@(user.IsBlocked?"Bloqueado":"Habilitado")</em><small>@(user.EmailConfirmed?"Correo confirmado":"Correo pendiente")</small></span><span><em class="badge @(user.IsOnline?"online":"offline")">@(user.IsOnline?"Online":"Offline")</em><small>@Format(user.LastActivityAt)</small></span><span><a href="@($"/admin/users/{user.Id}")">Ver detalle</a></span></div>}</div>}
</section>
@code{private PlatformUserPageResponse? result;private string? search,role,state,error;private bool loading=true;protected override Task OnInitializedAsync()=>LoadAsync();private async Task LoadAsync(){loading=true;error=null;try{bool? blocked=state is "blocked"?true:state is "available"?false:null;bool? online=state is "online"?true:state is "offline"?false:null;result=await Api.SearchUsersAsync(search,role,blocked,online);}catch(HttpRequestException){error="No fue posible cargar los usuarios.";}finally{loading=false;}}private static string Tenant(PlatformUserListItemResponse u)=>u.TenantName is null?"Sin tenant":$"{u.TenantCode} · {u.TenantName}";private static string RoleText(string r)=>r=="PLATFORM_ADMIN"?"Platform admin":"Tenant owner";private static string Format(DateTime? d)=>d?.ToLocalTime().ToString("dd MMM yyyy HH:mm")??"Sin actividad";}
