@page "/cuenta"
@attribute [Authorize(Roles = "TENANT_OWNER")]

@using SweetSecrets.Contracts.Auth
@using SweetSecrets.Web.Services.Auth

@inject AuthApiClient AuthApiClient
@inject NavigationManager Navigation

<PageTitle>Mi cuenta - SweetSecrets</PageTitle>

<div class="account-page">
    <header class="page-header">
        <p class="eyebrow">Cuenta</p>
        <h1>Mi cuenta</h1>
        <p>Administra tu información, preferencias y seguridad.</p>
    </header>

    @if (_isLoading)
    {
        <section class="account-card status-card" aria-live="polite">Cargando información de la cuenta...</section>
    }
    else if (_loadError is not null)
    {
        <section class="account-card error-message" role="alert">
            <p>@_loadError</p>
            <button type="button" class="secondary-button" @onclick="LoadAccountAsync">Reintentar</button>
        </section>
    }
    else
    {
        <div class="account-grid">
            <section class="account-card personal-card">
                <span class="account-card-icon" aria-hidden="true">♡</span>
                <h2>Información personal</h2>
                <dl class="account-details">
                    <div><dt>Nombre</dt><dd>@_account?.FullName</dd></div>
                    <div><dt>Correo electrónico</dt><dd>@_account?.Email</dd></div>
                </dl>
            </section>

            <a class="account-card account-action-card settings-action" href="/configuracion">
                <span class="account-card-icon" aria-hidden="true">⚙</span>
                <span><strong>Configuración</strong><small>Preferencias de SweetSecrets</small></span>
                <span class="account-chevron" aria-hidden="true">→</span>
            </a>

            <section class="account-card account-action-card security-card">
                <span class="account-card-icon" aria-hidden="true">◇</span>
                <span><strong>Seguridad</strong><small>Cambia la contraseña de tu cuenta</small></span>
                <button type="button" class="secondary-button" @onclick="OpenPasswordModal">Cambiar contraseña</button>
            </section>

            @if (_successMessage is not null)
            {
                <div class="success-message account-success" role="status">@_successMessage</div>
            }

            <section class="account-card account-action-card session-card">
                <span class="account-card-icon" aria-hidden="true">↪</span>
                <span><strong>Sesión</strong><small>Cierra tu sesión de forma segura en este dispositivo</small></span>
                <button type="button" class="logout-account-button" disabled="@_isLoggingOut" @onclick="LogoutAsync">
                    @(_isLoggingOut ? "Cerrando sesión..." : "Cerrar sesión")
                </button>
            </section>
        </div>
    }
</div>

@if (_showPasswordModal)
{
    <div class="account-modal-backdrop">
        <section class="account-modal" role="dialog" aria-modal="true" aria-labelledby="change-password-title">
            <header class="account-modal-header">
                <div>
                    <span class="eyebrow">Seguridad</span>
                    <h2 id="change-password-title">Cambiar contraseña</h2>
                </div>
                <button type="button" class="modal-close" aria-label="Cerrar" disabled="@_isSaving" @onclick="CancelPasswordModal">×</button>
            </header>

            <p class="card-description">La nueva contraseña debe cumplir la política de seguridad de SweetSecrets.</p>

            <EditForm Model="_password" OnValidSubmit="ChangePasswordAsync">
                <div class="form-group">
                    <label for="current-password">Contraseña actual</label>
                    <InputText id="current-password" class="form-control" type="password" autocomplete="current-password" autofocus @bind-Value="_password.CurrentPassword" />
                </div>
                <div class="form-group">
                    <label for="new-password">Nueva contraseña</label>
                    <InputText id="new-password" class="form-control" type="password" autocomplete="new-password" @bind-Value="_password.NewPassword" />
                </div>
                <div class="form-group">
                    <label for="confirm-password">Confirmar nueva contraseña</label>
                    <InputText id="confirm-password" class="form-control" type="password" autocomplete="new-password" @bind-Value="_confirmation" />
                </div>

                @if (_changeError is not null)
                {
                    <div class="error-message" role="alert">@_changeError</div>
                }

                <div class="account-modal-actions">
                    <button type="button" class="secondary-button" disabled="@_isSaving" @onclick="CancelPasswordModal">Cancelar</button>
                    <button type="submit" class="primary-button" disabled="@_isSaving">
                        @(_isSaving ? "Guardando..." : "Cambiar contraseña")
                    </button>
                </div>
            </EditForm>
        </section>
    </div>
}

@code {
    private AccountResponse? _account;
    private ChangePasswordRequest _password = new();
    private string _confirmation = string.Empty;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isLoggingOut;
    private bool _showPasswordModal;
    private string? _loadError;
    private string? _changeError;
    private string? _successMessage;

    protected override async Task OnInitializedAsync() => await LoadAccountAsync();

    private async Task LoadAccountAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            var result = await AuthApiClient.GetAccountAsync();
            if (result.Succeeded)
                _account = result.Account;
            else
                _loadError = result.ErrorMessage ?? "No fue posible cargar la cuenta.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        if (_isSaving)
            return;

        _successMessage = null;
        _changeError = string.IsNullOrWhiteSpace(_password.CurrentPassword)
            ? "La contraseña actual es obligatoria."
            : string.IsNullOrWhiteSpace(_password.NewPassword)
                ? "La nueva contraseña es obligatoria."
                : !string.Equals(_password.NewPassword, _confirmation, StringComparison.Ordinal)
                    ? "La confirmación no coincide con la nueva contraseña."
                    : null;

        if (_changeError is not null)
            return;

        _isSaving = true;
        try
        {
            var result = await AuthApiClient.ChangePasswordAsync(_password);
            if (!result.Succeeded)
            {
                _changeError = result.ErrorMessage ?? "No fue posible cambiar la contraseña.";
                return;
            }

            _successMessage = result.Message;
            ClosePasswordModal();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenPasswordModal()
    {
        ClearPasswordState();
        _successMessage = null;
        _showPasswordModal = true;
    }

    private void CancelPasswordModal() => ClosePasswordModal();

    private void ClosePasswordModal()
    {
        _showPasswordModal = false;
        ClearPasswordState();
    }

    private void ClearPasswordState()
    {
        _password = new ChangePasswordRequest();
        _confirmation = string.Empty;
        _changeError = null;
    }

    private async Task LogoutAsync()
    {
        if (_isLoggingOut)
            return;

        _isLoggingOut = true;
        try
        {
            await AuthApiClient.LogoutAsync();
            Navigation.NavigateTo("/login", replace: true);
        }
        finally
        {
            _isLoggingOut = false;
        }
    }
}
