@page "/"
@attribute [Authorize(Roles = "TENANT_OWNER")]

@using SweetSecrets.Web.Services.Auth

@inject AuthApiClient AuthApiClient
@inject NavigationManager Navigation

<PageTitle>Inicio - SweetSecrets</PageTitle>

<h1>SweetSecrets</h1>

<p>Sesión de TENANT_OWNER activa correctamente.</p>

<button @onclick="LogoutAsync">
    Cerrar sesión
</button>

@code {
    private async Task LogoutAsync()
    {
        await AuthApiClient.LogoutAsync();

        Navigation.NavigateTo(
            "/login",
            replace: true);
    }
}