@page "/"
@attribute [Authorize(Roles = "TENANT_OWNER")]

<PageTitle>Inicio - SweetSecrets</PageTitle>

<section class="dashboard">
    <div class="dashboard-heading">
        <div>
            <span class="dashboard-eyebrow">
                Resumen
            </span>

            <h1>Bienvenido a SweetSecrets</h1>

            <p>
                Administra los costos de tus productos y recetas desde un solo lugar.
            </p>
        </div>
    </div>

    <div class="dashboard-cards">
        <article class="dashboard-card">
            <div class="dashboard-card-icon">
                □
            </div>

            <div>
                <span class="dashboard-card-label">
                    Productos
                </span>

                <strong>Catálogo de ingredientes</strong>

                <p>
                    Consulta y administra precios, cantidades y unidades de compra.
                </p>
            </div>
        </article>

        <article class="dashboard-card">
            <div class="dashboard-card-icon">
                ≡
            </div>

            <div>
                <span class="dashboard-card-label">
                    Recetas
                </span>

                <strong>Costeo de recetas</strong>

                <p>
                    Construye recetas y calcula automáticamente su costo.
                </p>
            </div>
        </article>

        <article class="dashboard-card">
            <div class="dashboard-card-icon">
                ⚙
            </div>

            <div>
                <span class="dashboard-card-label">
                    Configuración
                </span>

                <strong>Preferencias de cuenta</strong>

                <p>
                    Administra la configuración operativa de tu espacio.
                </p>
            </div>
        </article>
    </div>
</section>