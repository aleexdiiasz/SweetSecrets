@page "/reset-password"
@layout AuthLayout

@using SweetSecrets.Contracts.Auth
@using SweetSecrets.Web.Services.Auth

@inject AuthApiClient AuthApiClient

<PageTitle>Restablecer contraseña - SweetSecrets</PageTitle>

<div class="reset-card">
    <div class="reset-header">
        <h1>Restablecer contraseña</h1>
        <p>Elige una nueva contraseña segura para tu cuenta.</p>
    </div>

    @if (_successMessage is not null)
    {
        <div class="reset-success" role="status">@_successMessage</div>
        <a class="primary-link" href="/login">Iniciar sesión</a>
    }
    else if (!_hasValidLink)
    {
        <div class="reset-error" role="alert">El enlace de recuperación no es válido o está incompleto.</div>
        <a class="primary-link" href="/forgot-password">Solicitar un nuevo enlace</a>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <div class="form-group">
                <label for="new-password">Nueva contraseña</label>
                <InputText id="new-password" class="form-control" type="password" autocomplete="new-password" @bind-Value="_model.NewPassword" />
                <small>Mínimo 10 caracteres, con mayúscula, minúscula, número y símbolo.</small>
            </div>

            <div class="form-group">
                <label for="confirm-password">Confirmar contraseña</label>
                <InputText id="confirm-password" class="form-control" type="password" autocomplete="new-password" @bind-Value="_confirmation" />
            </div>

            @if (_errorMessage is not null)
            {
                <div class="reset-error" role="alert">@_errorMessage</div>
            }

            <button type="submit" class="reset-button" disabled="@_isSubmitting">
                @(_isSubmitting ? "Actualizando..." : "Cambiar contraseña")
            </button>
        </EditForm>
    }
</div>

@code {
    private readonly ResetPasswordRequest _model = new();
    private string _confirmation = string.Empty;
    private bool _isSubmitting;
    private bool _hasValidLink;
    private string? _errorMessage;
    private string? _successMessage;

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    protected override void OnParametersSet()
    {
        _hasValidLink = !string.IsNullOrWhiteSpace(Email) && !string.IsNullOrWhiteSpace(Token);
        _model.Email = Email ?? string.Empty;
        _model.Token = Token ?? string.Empty;
    }

    private async Task SubmitAsync()
    {
        if (_isSubmitting)
            return;

        _errorMessage = string.IsNullOrWhiteSpace(_model.NewPassword)
            ? "La nueva contraseña es obligatoria."
            : !string.Equals(_model.NewPassword, _confirmation, StringComparison.Ordinal)
                ? "Las contraseñas no coinciden."
                : null;

        if (_errorMessage is not null)
            return;

        _isSubmitting = true;

        try
        {
            var result = await AuthApiClient.ResetPasswordAsync(_model);

            if (!result.Succeeded)
            {
                _errorMessage = result.ErrorMessage ?? "No fue posible cambiar la contraseña.";
                return;
            }

            _successMessage = result.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
