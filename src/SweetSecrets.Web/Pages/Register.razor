@page "/register"
@layout AuthLayout

@using SweetSecrets.Contracts.Auth
@using SweetSecrets.Web.Services.Auth

@inject AuthApiClient AuthApiClient
@inject NavigationManager Navigation

<PageTitle>Crear cuenta - SweetSecrets</PageTitle>

<div class="register-card">
    <div class="register-header">
        <h1>Crear cuenta</h1>
        <p>Comienza a organizar los costos y recetas de tu negocio.</p>
    </div>

    <EditForm Model="_model" OnValidSubmit="HandleRegistrationAsync">
        <div class="form-group">
            <label for="business-name">Nombre del negocio</label>
            <InputText id="business-name" class="form-control" maxlength="200" autocomplete="organization" @bind-Value="_model.BusinessName" />
        </div>

        <div class="form-group">
            <label for="full-name">Nombre del propietario</label>
            <InputText id="full-name" class="form-control" maxlength="200" autocomplete="name" @bind-Value="_model.FullName" />
        </div>

        <div class="form-group">
            <label for="email">Correo electrónico</label>
            <InputText id="email" class="form-control" type="email" autocomplete="email" @bind-Value="_model.Email" />
        </div>

        <div class="form-group">
            <label for="password">Contraseña</label>
            <InputText id="password" class="form-control" type="password" autocomplete="new-password" @bind-Value="_model.Password" />
            <small>Mínimo 10 caracteres, con mayúscula, minúscula, número y símbolo.</small>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="register-error" role="alert">@_errorMessage</div>
        }

        <button type="submit" class="register-button" disabled="@_isSubmitting">
            @(_isSubmitting ? "Creando cuenta y preparando tu espacio..." : "Crear cuenta")
        </button>
    </EditForm>

    <p class="auth-link">
        ¿Ya tienes cuenta?
        <a href="/login">Iniciar sesión</a>
    </p>
</div>

@code {
    private readonly RegisterRequest _model = new();
    private bool _isSubmitting;
    private string? _errorMessage;

    private async Task HandleRegistrationAsync()
    {
        if (_isSubmitting)
            return;

        _errorMessage = Validate();

        if (_errorMessage is not null)
            return;

        _isSubmitting = true;

        try
        {
            var result = await AuthApiClient.RegisterAsync(_model);

            if (!result.Succeeded)
            {
                _errorMessage = result.ErrorMessage ?? "No fue posible crear la cuenta.";
                return;
            }

            Navigation.NavigateTo(
                $"/confirm-email?email={Uri.EscapeDataString(result.Response!.Email)}&registered=true",
                replace: true);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private string? Validate()
    {
        if (string.IsNullOrWhiteSpace(_model.BusinessName))
            return "El nombre del negocio es obligatorio.";

        if (string.IsNullOrWhiteSpace(_model.FullName))
            return "El nombre del propietario es obligatorio.";

        if (string.IsNullOrWhiteSpace(_model.Email) ||
            !_model.Email.Contains('@', StringComparison.Ordinal))
            return "Ingresa un correo electrónico válido.";

        if (string.IsNullOrWhiteSpace(_model.Password))
            return "La contraseña es obligatoria.";

        if (_model.Password.Length < 10 ||
            !_model.Password.Any(char.IsUpper) ||
            !_model.Password.Any(char.IsLower) ||
            !_model.Password.Any(char.IsDigit) ||
            !_model.Password.Any(character => !char.IsLetterOrDigit(character)))
            return "La contraseña debe tener al menos 10 caracteres, mayúscula, minúscula, número y símbolo.";

        return null;
    }
}
