{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimiting": {
    "PublicAuth": {
      "Login": { "PermitLimit": 10, "WindowMinutes": 5 },
      "Register": { "PermitLimit": 3, "WindowMinutes": 60 },
      "EmailDelivery": { "PermitLimit": 5, "WindowMinutes": 15 },
      "TokenValidation": { "PermitLimit": 10, "WindowMinutes": 15 }
    }
  },
  "AllowedHosts": "*"
}
